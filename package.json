{
  "name": "boomerang-lost-found",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-sqlite server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --experimental-sqlite server/index.js",
    "test": "node --experimental-sqlite --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src server shared tests *.js *.json index.html",
    "format:check": "prettier --check src server shared tests *.js *.json index.html"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  }
}
